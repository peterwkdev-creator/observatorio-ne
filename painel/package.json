{
  "name": "observatorio-ne-painel",
  "version": "0.1.0",
  "private": true,
  "description": "Painel estático do Observatório NE. Lê o snapshot JSON gerado pelo motor Python.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/enxugar.mjs",
    "build:completo": "next build",
    "start": "npx serve out",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/registrar.mjs --test tests/*.test.mts",
    "conferir-xlsx": "node scripts/conferir-xlsx.mjs out/dados/municipios.xlsx out/dados/municipios.csv",
    "indexnow": "node scripts/indexnow.mjs",
    "auditar": "node scripts/auditar.mjs http://127.0.0.1:8791 / /ajuda/ /estado/ce/ /estado/rs/ /estado/df/ /municipio/imperatriz-ma/ /municipio/guaratinga-ba/ /municipio/volta-redonda-rj/ /municipio/brasilia-df/"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "typescript": "5.8.3"
  },
  "license": "AGPL-3.0-or-later"
}
